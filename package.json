{
  "name": "sky-touchscreen-viz",
  "version": "1.0.0",
  "type": "module",
  "description": "Interaktive Web-Visualisierung für das Sky Sport Touchscreen System",
  "main": "index.html",
  "scripts": {
    "dev": "netlify dev",
    "build": "echo 'Static site - no build needed'",
    "start": "npx serve .",
    "functions": "netlify functions:serve",
    "setup-db": "node scripts/setup-notion-db.js",
    "sync-notion": "node mcp-notion-server/sync-notion.js",
    "lint": "eslint js/*.js",
    "lint:fix": "eslint js/*.js --fix",
    "format": "prettier --write 'js/**/*.js' 'css/**/*.css' '*.html'",
    "format:check": "prettier --check 'js/**/*.js' 'css/**/*.css' '*.html'"
  },
  "keywords": [
    "sky",
    "sport",
    "touchscreen",
    "visualization",
    "notion"
  ],
  "author": "Yan",
  "license": "MIT",
  "dependencies": {
    "@notionhq/client": "^2.2.14",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "netlify-cli": "^17.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
